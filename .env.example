# Copy to .env and fill in. Never commit .env.

# Neon "dev" branch, connection pooling ON. Used by the API at runtime.
DATABASE_URL=

# Neon "dev" branch, connection pooling OFF (direct). Used by `make migrate-*`.
MIGRATE_DATABASE_URL=

# Origins allowed to call the API. Production uses https://pick.rajwalgautam.com.
ALLOWED_ORIGINS=http://localhost:3000
